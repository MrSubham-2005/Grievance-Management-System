# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, or any Postgres 14+ with SSL).
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Secret used to sign session cookies. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# AI complaint analysis (optional). Leave AI_API_KEY empty to disable it.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=

# Status-change emails to students (optional). Leave RESEND_API_KEY empty to skip email.
# NOTIFY_FROM must be a sender verified in Resend.
RESEND_API_KEY=
NOTIFY_FROM=

# Port for the local server (optional, defaults to 4000).
# PORT=4000
